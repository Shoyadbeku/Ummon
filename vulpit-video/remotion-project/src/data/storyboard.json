   "audioEnd": 227.07,
   "image": "images/35_yashil_odamlar_yurti.jpg",
   "motion": "panR",
   "fx": 0.4,
   "fy": 0.55,
   "z0": 1.05,
   "z1": 1.12,
   "note": "Yashil odamlar",
   "narration": "U yerda yashaydigan hamma odamlar yashil rangda edi."
  },
  {
   "id": "S39",
   "from": 7303,
   "to": 7556,
   "audioStart": 227.07,
   "audioEnd": 235.51,
   "image": "images/34_avliyo_martin_yurti_shom.jpg",
   "motion": "panL",
   "fx": 0.62,
   "fy": 0.45,
   "z0": 1.12,
   "z1": 1.2,
   "note": "Quyosh chiqmaydigan yurt",
   "narration": "Eng g'alatisi, u yerda quyosh hech qachon chiqmagan. Doimiy shom, abadiy ala-qorong'ilik hukm surgan."
  },
  {
   "id": "S40",
   "from": 7556,
   "to": 7731,
   "audioStart": 235.51,
   "audioEnd": 241.32,
   "image": "images/35_yashil_odamlar_yurti.jpg",
   "motion": "pullOut",
   "fx": 0.55,
   "fy": 0.4,
   "z0": 1.3,
   "z1": 1.05,
   "note": "G'ira-shira yorug'lik",
   "narration": "Xuddi quyosh botgandan keyingi yoki chiqishidan oldingi g'ira-shira yorug'likdek."
  },
  {
   "id": "S41",
   "from": 7731,
   "to": 8018,
   "audioStart": 241.32,
   "audioEnd": 250.9,
   "image": "images/36_daryo_narigi_tomonidagi_yorug_yurt.jpg",
   "motion": "pushIn",
   "fx": 0.5,
   "fy": 0.45,
   "z0": 1.0,
   "z1": 1.2,
   "note": "Daryo narigi yorug' yurt",
   "narration": "Qizning so'zlariga ko'ra, daryoning narigi tomonida yorug' bir mamlakat ko'rinib turardi. Ammo ular u yerga hech qachon borishmagan."
  },
  {
   "id": "S42",
   "from": 8018,
   "to": 8402,
   "audioStart": 250.9,
   "audioEnd": 263.69,
   "image": "images/37_poda_va_qongiroq_ovozi.jpg",
   "motion": "panR",
   "fx": 0.35,
   "fy": 0.5,
   "z0": 1.05,
   "z1": 1.12,
   "note": "Poda va qo'ng'iroq",
   "narration": "Ular qanday qilib Vulpitga kelib qolishgan? Qizning hikoyasi ikki xil yozib qoldirilgan. Bir versiyaga ko'ra, ular otalarining podasini boqib yurganda, qo'ng'iroqlarning go'zal ovozini eshitishgan."
  },
  {
   "id": "S43",
   "from": 8402,
   "to": 8624,
   "audioStart": 263.69,
   "audioEnd": 271.09,
   "image": "images/38_qorongi_gorga_kirish.jpg",
   "motion": "pushIn",
   "fx": 0.5,
   "fy": 0.55,
   "z0": 1.0,
   "z1": 1.35,
   "note": "Qorong'i g'or",
   "narration": "Ovozga ergashib, ular uzun, qorong'i g'orga kirib qolishgan. G'or ichida qancha yurishganini bilishmagan."
  },
  {
   "id": "S44",
   "from": 8624,
   "to": 9057,
   "audioStart": 271.09,
   "audioEnd": 285.52,
   "image": "images/39_quyosh_nuridan_hushdan_ketish.jpg",
   "motion": "flash",
   "fx": 0.4,
   "fy": 0.5,
   "z0": 1.25,
   "z1": 1.0,
   "note": "Ko'zni qamashtiruvchi quyosh",
   "narration": "Va birdan ular o'zlarini ko'zni qamashtiruvchi yorug' quyosh nuri ostida, o'sha bo'ri o'ralari yonida topishgan. Yorug'lik va issiqlik ularni shunchalik hayratga solganki, ular hushidan ketib yerga yiqilishgan."
  },
  {
   "id": "S45",
   "from": 9057,
   "to": 9210,
   "audioStart": 285.52,
   "audioEnd": 290.64,
   "image": "images/38_qorongi_gorga_kirish.jpg",
   "motion": "pullOut",
   "fx": 0.45,
   "fy": 0.5,
   "z0": 1.3,
   "z1": 1.05,
   "note": "Qaytish yo'li yo'q",
   "narration": "Ular qaytish yo'lini qidirishgan, ammo g'or kirishini topa olmagan."
  },
  {
   "id": "S46",
   "from": 9210,
   "to": 9481,
   "audioStart": 290.64,
   "audioEnd": 299.68,
   "image": "images/32_qizning_soglom_ulgayishi.jpg",
   "motion": "panL",
   "fx": 0.55,
   "fy": 0.5,
   "z0": 1.1,
   "z1": 1.18,
   "note": "Xizmatkor qiz — Agnes",
   "narration": "Qiz keyinchalik ser Richardning uyida xizmatkor bo'lib, uzoq yillar ishladi. Uning ismi Agnes bo'lgan, deyishadi."
  },
  {
   "id": "S47",
   "from": 9481,
   "to": 9661,
   "audioStart": 299.68,
   "audioEnd": 305.66,
   "image": "images/40_agnes_va_turmush_hayoti.jpg",
   "motion": "pushIn",
   "fx": 0.45,
   "fy": 0.5,
   "z0": 1.0,
   "z1": 1.15,
   "note": "Turmush",
   "narration": "Koggeshollik Ralfning yozishicha, u keyinchalik qo'shni shahardagi bir erkakka turmushga chiqqan."
  },
  {
   "id": "S48",
   "from": 9661,
   "to": 10001,
   "audioStart": 305.66,
   "audioEnd": 316.99,
   "image": "images/18_butun_qishloq_yigilishi.jpg",
   "motion": "panR",
   "fx": 0.4,
   "fy": 0.5,
   "z0": 1.1,
   "z1": 1.15,
   "note": "Avlodlar",
   "narration": "Ba'zi tadqiqotchilar hatto bugungi kunda Angliyada yashayotgan ba'zi oilalar uning avlodlari bo'lishi mumkin, deb taxmin qilishadi. Ammo bu isbotlanmagan."
  },
  {
   "id": "S49",
   "from": 10001,
   "to": 10329,
   "audioStart": 316.99,
   "audioEnd": 327.95,
   "image": "images/41_olimlar_tadqiqoti.jpg",
   "motion": "pushIn",
   "fx": 0.5,
   "fy": 0.5,
   "z0": 1.0,
   "z1": 1.18,
   "note": "Olimlar izlanishi",
   "narration": "Xo'sh, bu voqea aslida nima edi? Asrlar davomida olimlar, tarixchilar va sir izlovchilar bu savolga javob topishga harakat qilishdi."
  },
  {
   "id": "S50",
   "from": 10329,
   "to": 10793,
   "audioStart": 327.95,
   "audioEnd": 343.39,
   "image": "images/42_xloroz_yashil_kasallik.jpg",
   "motion": "panR",
   "fx": 0.45,
   "fy": 0.5,
   "z0": 1.05,
   "z1": 1.12,
   "note": "Xloroz",
   "narration": "Birinchi va eng ilmiy tushuntirish kasallik bilan bog'liq. Tibbiyotda xloroz deb ataladigan kasallik bor. Uni ba'zan «yashil kasallik» ham deyishadi. Bu og'ir to'yib ovqatlanmaslik natijasida kelib chiqadigan kamqonlikning bir turi."
  },
  {
   "id": "S51",
   "from": 10793,
   "to": 11214,
   "audioStart": 343.39,
   "audioEnd": 357.44,
   "image": "images/29_yashil_rang_yoqolishi.jpg",
   "motion": "pushIn",
   "fx": 0.5,
   "fy": 0.45,
   "z0": 1.15,
   "z1": 1.35,
   "note": "Och-yashil tus",
   "narration": "U terini och-yashil tusga kiritishi mumkin. Agar bolalar uzoq vaqt och qolib, yaxshi ovqatlanmagan bo'lsa, ularning terisi yashil bo'lib ko'rinishi mumkin edi. Va ular normal ovqatlana boshlagach, rang asta-sekin yo'qolgan."
  },
  {
   "id": "S52",
   "from": 11214,
   "to": 11482,
   "audioStart": 357.44,
   "audioEnd": 366.38,
   "image": "images/22_ochlikdan_holsizlanish.jpg",
   "motion": "panL",
   "fx": 0.5,
   "fy": 0.5,
   "z0": 1.05,
   "z1": 1.12,
   "note": "Nega och qolgan?",
   "narration": "Bu juda mantiqli tushuntirish. Ammo bolalar qayerdan kelgan va nega bunchalik och qolgan?"
  },
  {
   "id": "S53",
   "from": 11482,
   "to": 11931,
   "audioStart": 366.38,
   "audioEnd": 381.32,
   "image": "images/43_flamand_toquvchilari.jpg",
   "motion": "pushIn",
   "fx": 0.5,
   "fy": 0.5,
   "z0": 1.0,
   "z1": 1.15,
   "note": "Flamand to'quvchilar",
   "narration": "Bu savolga javob beradigan qiziq nazariyani tarixchi Pol Xarris ilgari surdi. O'sha davrda Angliyaga Flandriyadan, ya'ni bugungi Belgiyadan ko'plab muhojir hunarmandlar kelib joylashgan edi. Ular to'qimachilik bilan shug'ullanishardi."
  },
  {
   "id": "S54",
   "from": 11931,
   "to": 12079,
   "audioStart": 381.32,
   "audioEnd": 386.26,
   "image": "images/44_flamandlar_taqibi.jpg",
   "motion": "shake",
   "fx": 0.5,
   "fy": 0.5,
   "z0": 1.05,
   "z1": 1.15,
   "note": "Ta'qib",
   "narration": "O'n ikkinchi asrda bu muhojirlar ta'qibga uchrab, ularning ko'pi o'ldirilgan."
  },
  {
   "id": "S55",
   "from": 12079,
   "to": 12516,
   "audioStart": 386.26,
   "audioEnd": 400.83,
   "image": "images/45_ormondagi_flamand_yetimlari.jpg",
   "motion": "pushIn",
   "fx": 0.45,
   "fy": 0.55,
   "z0": 1.0,
   "z1": 1.25,
   "note": "O'rmondagi yetimlar",
   "narration": "Xarrisning fikricha, yashil bolalar ota-onasi o'ldirilgan flamand yetimlari bo'lishi mumkin. Ular o'rmonlarda yashirinib, uzoq vaqt och-nahor yurishgan. Ularning g'alati tili flamand tili, g'alati kiyimlari esa flamand kiyimi bo'lgan."
  },
  {
   "id": "S56",
   "from": 12516,
   "to": 12679,
   "audioStart": 400.83,
   "audioEnd": 406.27,
   "image": "images/07_tushunarsiz_tilda_sozlash.jpg",
   "motion": "panR",
   "fx": 0.4,
   "fy": 0.5,
   "z0": 1.12,
   "z1": 1.18,
   "note": "Tushunmagan dehqonlar",
   "narration": "Ingliz dehqonlari bu tilni hech qachon eshitmaganligi uchun uni tushunmaganlar."
  },
  {
   "id": "S57",
   "from": 12679,
   "to": 13021,
   "audioStart": 406.27,
   "audioEnd": 417.67,
   "image": "images/46_fordem_sent_martin_qishlogi.jpg",
   "motion": "tiltDown",
   "fx": 0.5,
   "fy": 0.45,
   "z0": 1.15,
   "z1": 1.0,
   "note": "Fordem Sent-Martin",
   "narration": "Va eng qiziq tafsilot: Vulpitdan unchalik uzoq bo'lmagan joyda Fordem Sent-Martin deb ataladigan qishloq bor. U qishloq daryo bilan ajratilgan."
  },
  {
   "id": "S58",
   "from": 13021,
   "to": 13271,
   "audioStart": 417.67,
   "audioEnd": 426.01,
   "image": "images/36_daryo_narigi_tomonidagi_yorug_yurt.jpg",
   "motion": "panL",
   "fx": 0.55,
   "fy": 0.5,
   "z0": 1.1,
   "z1": 1.18,
   "note": "Avliyo Martin yurti?",
   "narration": "Ehtimol, qorong'i o'rmonlarda yashagan va quyosh nurini kam ko'rgan bolalar uchun bu qishloq «Avliyo Martin yurti» bo'lgandir."
  },
  {
   "id": "S59",
   "from": 13271,
   "to": 13448,
   "audioStart": 426.01,
   "audioEnd": 431.91,
   "image": "images/47_zich_ormon_soyasi.jpg",
   "motion": "pushIn",
   "fx": 0.5,
   "fy": 0.5,
   "z0": 1.0,
   "z1": 1.22,
   "note": "Zich o'rmon soyasi",
   "narration": "Va ular ko'rgan doimiy shom esa zich o'rmonlar soyasidagi hayot bo'lgandir."
  },
  {
   "id": "S60",
   "from": 13448,
   "to": 13859,
   "audioStart": 431.91,
   "audioEnd": 445.59,
   "image": "images/48_tanqidchilar_bahsi.jpg",
   "motion": "panR",
   "fx": 0.45,
   "fy": 0.5,
   "z0": 1.05,
   "z1": 1.12,
   "note": "Tanqidchilar",
   "narration": "bu tushuntirish juda ishonarli eshitiladi, ammo tanqidchilar uning zaif tomonlarini ham ko'rsatishadi. Masalan, nega o'sha davrning bilimli tarixchilari, ko'p muhojirlarni ko'rgan odamlar flamand tilini taniy olishmadi?"
  },
  {
   "id": "S61",
   "from": 13859,
   "to": 14004,
   "audioStart": 445.59,
   "audioEnd": 450.43,
   "image": "images/49_noma_lum_non_jumbogi.jpg",
   "motion": "pushIn",
   "fx": 0.5,
   "fy": 0.55,
   "z0": 1.0,
   "z1": 1.3,
   "note": "Non jumbog'i",
   "narration": "Va nega bolalar oddiy ovqatlarni, nonni ham taniy olishmadi?"
  },
  {
   "id": "S62",
   "from": 14004,
   "to": 14230,
   "audioStart": 450.43,
   "audioEnd": 457.96,
   "image": "images/50_yer_osti_dunyosi_nazariyasi.jpg",
   "motion": "pushIn",
   "fx": 0.5,
   "fy": 0.55,
   "z0": 1.0,
   "z1": 1.2,
   "note": "Yer osti dunyosi",
   "narration": "Boshqa nazariyalar ancha g'ayrioddiy. Ba'zilar bolalar yer ostidagi noma'lum dunyodan kelgan, deb ishonishadi."
  },
  {
   "id": "S63",
   "from": 14230,
   "to": 14566,
   "audioStart": 457.96,
   "audioEnd": 469.18,
   "image": "images/51_ingliz_folklori_parilar_olami.jpg",
   "motion": "drift",
   "fx": 0.5,
   "fy": 0.5,
   "z0": 1.05,
   "z1": 1.15,
   "note": "Parilar olami",
   "narration": "O'rta asrlarda ko'p odamlar yer ostida boshqa mavjudotlar yashashiga ishonishgan. Ingliz xalq og'zaki ijodida yashil rang ko'pincha parilar va sehrli dunyo bilan bog'langan."
  },
  {
   "id": "S64",
   "from": 14566,
   "to": 15066,
   "audioStart": 469.18,
   "audioEnd": 485.85,
   "image": "images/52_abadiy_shomli_sayyora.jpg",
   "motion": "rotate",
   "fx": 0.5,
   "fy": 0.5,
   "z0": 1.0,
   "z1": 1.2,
   "note": "Boshqa sayyora",
   "narration": "Yigirmanchi asrda esa yanada hayratlanarli nazariyalar paydo bo'ldi. Ba'zi yozuvchilar bu bolalar boshqa sayyoradan, ehtimol, doimo bir tomoni bilan quyoshga qarab turadigan, shuning uchun abadiy shom hukm suradigan sayyoradan adashib kelib qolgan, deb taxmin qilishdi."
  },
  {
   "id": "S65",
   "from": 15066,
   "to": 15388,
   "audioStart": 485.85,
   "audioEnd": 496.55,
   "image": "images/53_fotosintez_nazariyasi.jpg",
   "motion": "pushIn",
   "fx": 0.5,
   "fy": 0.55,
   "z0": 1.0,
   "z1": 1.2,
   "note": "Fotosintez farazi",
   "narration": "Va ularning yashil rangi esa o'simliklar kabi fotosintezga moslashgan tana bo'lishi mumkin, deyishdi. Albatta, buni tasdiqlovchi hech qanday ilmiy dalil yo'q."
  },
  {
   "id": "S66",
   "from": 15388,
   "to": 15914,
   "audioStart": 496.55,
   "audioEnd": 514.1,
   "image": "images/54_rivoyat_yoki_tarixiy_fakt.jpg",
   "motion": "panL",
   "fx": 0.55,
   "fy": 0.5,
   "z0": 1.12,
   "z1": 1.2,
   "note": "Rivoyat yoki fakt",
   "narration": "Ba'zi tarixchilar esa bu hikoya umuman haqiqiy voqea emas, balki qandaydir ma'noni ifodalovchi rivoyat bo'lishi mumkin, deb hisoblashadi. Ammo unda nega ikki jiddiy tarixchi uni haqiqat sifatida, guvohlar ismlari va joy nomlari bilan yozib qoldirdi?"
  },
  {
   "id": "S67",
   "from": 15914,
   "to": 16172,
   "audioStart": 514.1,
   "audioEnd": 522.68,
   "image": "images/55_bugungi_vulpit_belgisi.jpg",
   "motion": "pushIn",
   "fx": 0.3,
   "fy": 0.45,
   "z0": 1.0,
   "z1": 1.15,
   "note": "Bugungi Vulpit belgisi",
   "narration": "Bugun Vulpit qishlog'iga kirish joyida chiroyli belgi turibdi. Unda ikki bola tasvirlangan, bir o'g'il va bir qiz. Qo'l ushlashib turibdi."
  },
  {
   "id": "S68",
   "from": 16172,
   "to": 16487,
   "audioStart": 522.68,
   "audioEnd": 533.19,
   "image": "images/01_vulpit_qishlogi_12_asr.jpg",
   "motion": "panL",
   "fx": 0.55,
   "fy": 0.55,
   "z0": 1.1,
   "z1": 1.18,
   "note": "Avloddan-avlodga",
   "narration": "qishloq aholisi bu hikoyani faxr bilan avloddan-avlodga yetkazib kelmoqda. Ammo ular ham haqiqat nima ekanini bilishmaydi."
  },
  {
   "id": "S69",
   "from": 16487,
   "to": 16928,
   "audioStart": 533.19,
   "audioEnd": 547.9,
   "image": "images/56_begona_yurtda_ikki_bola.jpg",
   "motion": "pushIn",
   "fx": 0.5,
   "fy": 0.5,
   "z0": 1.0,
   "z1": 1.2,
   "note": "Begona yurtda ikki bola",
   "narration": "Endi bir o'ylab ko'ring. Ikki bola. Begona yurtda, begona odamlar orasida. Tilini tushunmaydigan, ovqatini taniy olmaydigan, terisi boshqacha bo'lgani uchun hamma hayrat bilan qaraydigan joyda."
  },
  {
   "id": "S70",
   "from": 16928,
   "to": 17014,
   "audioStart": 547.9,
   "audioEnd": 550.76,
   "image": "images/31_ogil_bolaning_vafoti.jpg",
   "motion": "dim",
   "fx": 0.4,
   "fy": 0.5,
   "z0": 1.15,
   "z1": 1.25,
   "note": "Biri vafot etdi",
   "narration": "Ularning biri tez orada vafot etdi."
  },
  {
   "id": "S71",
   "from": 17014,
   "to": 17195,
   "audioStart": 550.76,
   "audioEnd": 556.8,
   "image": "images/40_agnes_va_turmush_hayoti.jpg",
   "motion": "panR",
   "fx": 0.4,
   "fy": 0.5,
   "z0": 1.12,
   "z1": 1.18,
   "note": "Yangi hayot",
   "narration": "Ikkinchisi esa yangi hayotga moslashib, o'z o'tmishini asta-sekin unutdi."
  },
  {
   "id": "S72",
   "from": 17195,
   "to": 17735,
   "audioStart": 556.8,
   "audioEnd": 574.81,
   "image": "images/57_agnesning_yurt_soginchi.jpg",
   "motion": "pushIn",
   "fx": 0.62,
   "fy": 0.45,
   "z0": 1.0,
   "z1": 1.22,
   "note": "Agnesning sog'inchi",
   "narration": "Ehtimol, bu hikoyaning eng og'riqli tomoni ham aynan shudir. Biz hech qachon bilmaymiz. Bu qiz qolgan umri davomida o'z yurtini, o'sha abadiy shom bilan qoplangan yashil dunyoni sog'inib yashadimi?"
  },
  {
   "id": "S73",
   "from": 17735,
   "to": 18075,
   "audioStart": 574.81,
   "audioEnd": 586.13,
   "image": "images/18_butun_qishloq_yigilishi.jpg",
   "motion": "pullOut",
   "fx": 0.5,
   "fy": 0.5,
   "z0": 1.25,
   "z1": 1.05,
   "note": "Begonaga hayrat",
   "narration": "Balki yashil bolalar hikoyasi bizga shuni eslatadi. Begonani ko'rganimizda biz ko'pincha uni tushunishga emas, undan hayratlanishga shoshilamiz."
  },
  {
   "id": "S74",
   "from": 18075,
   "to": 18407,
   "audioStart": 586.13,
   "audioEnd": 597.22,
   "image": "images/58_inson_qalbidagi_sir.jpg",
   "motion": "pushIn",
   "fx": 0.5,
   "fy": 0.5,
   "z0": 1.0,
   "z1": 1.45,
   "note": "Inson qalbidagi sir",
   "narration": "Va ba'zan eng katta sir uzoq sayyoralarda emas, balki yonimizdagi notanish insonning qalbida yashiringan bo'ladi."
  },
  {
   "id": "S75",
   "from": 18407,
   "to": 18559,
   "audioStart": 597.22,
   "audioEnd": 602.26,
   "image": "images/59_yechilmagan_sir_savoli.jpg",
   "motion": "pushIn",
   "fx": 0.5,
   "fy": 0.55,
   "z0": 1.0,
   "z1": 1.15,
   "note": "Siz qanday o'ylaysiz?",
   "narration": "Siz-chi, qanday o'ylaysiz? Vulpitning yashil bolalari kim edi?"
  },
  {
   "id": "S76",
   "from": 18559,
   "to": 18608,
   "audioStart": 602.26,
   "audioEnd": 603.9,
   "image": "images/45_ormondagi_flamand_yetimlari.jpg",
   "motion": "punch",
   "fx": 0.45,
   "fy": 0.55,
   "z0": 1.15,
   "z1": 1.25,
   "note": "Och qolgan yetimlarmi?",
   "narration": "Och qolgan yetimlarmi?"
  },
  {
   "id": "S77",
   "from": 18608,
   "to": 18682,
   "audioStart": 603.9,
   "audioEnd": 606.38,
   "image": "images/50_yer_osti_dunyosi_nazariyasi.jpg",
   "motion": "punch",
   "fx": 0.5,
   "fy": 0.55,
   "z0": 1.15,
   "z1": 1.25,
   "note": "Yer osti dunyosimi?",
   "narration": "Yer osti dunyosidan kelganlarmi?"
  },
  {
   "id": "S78",
   "from": 18682,
   "to": 18839,
   "audioStart": 606.38,
   "audioEnd": 611.6,
   "image": "images/52_abadiy_shomli_sayyora.jpg",
   "motion": "punch",
   "fx": 0.5,
   "fy": 0.5,
   "z0": 1.1,
   "z1": 1.22,
   "note": "Boshqa bir sirmi?",
   "narration": "Yoki, biz hech qachon tushunmaydigan boshqa bir sirmi?"
  },
  {
   "id": "S79",
   "from": 18839,
   "to": 19029,
   "audioStart": 611.6,
   "audioEnd": 617.93,
   "image": "images/59_yechilmagan_sir_savoli.jpg",
   "motion": "pullOut",
   "fx": 0.5,
   "fy": 0.55,
   "z0": 1.25,
   "z1": 1.05,
   "note": "Izohlarda yozing",
   "narration": "Fikringizni izohlarda yozib qoldiring, eng qiziq javoblarni keyingi videoda o'qib beraman."
  },
  {
   "id": "S80",
   "from": 19029,
   "to": 19723,
   "audioStart": 617.93,
   "audioEnd": 641.07,
   "image": "images/60_outro_sirli_ufq.jpg",
   "motion": "pushIn",
   "fx": 0.5,
   "fy": 0.5,
   "z0": 1.0,
   "z1": 1.2,
   "note": "Outro",
   "narration": "Va agar siz ham bunday hal bo'lmagan sirlarni yaxshi ko'rsangiz, hoziroq «Qiziq-a?» kanaliga obuna bo'ling va qo'ng'iroqchani bosing, chunki keyingi videoda sizni bundan ham hayratlanarliroq, bundan ham tushunarsizroq sir kutmoqda. Uni o'tkazib yubormang. Yana uchrashguncha."
  }
 ],
