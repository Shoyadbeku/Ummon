# Copy to .env and fill only what you have. Every key is OPTIONAL:
# providers whose keys are missing are skipped and reported, never faked.

# --- Free, no key needed (always on) -----------------------------------
# Internet Archive, Wikimedia Commons, Library of Congress, Met Museum,
# Openverse, Rutube public search, yt-dlp discovery

# Wikimedia asks bots to identify themselves. Put a contact here (email or URL).
WIKIMEDIA_CONTACT=

# --- Stock video / photo (free keys) -----------------------------------
PEXELS_API_KEY=            # https://www.pexels.com/api/
PIXABAY_API_KEY=           # https://pixabay.com/api/docs/

# --- Archives / museums -----------------------------------------------
EUROPEANA_API_KEY=         # https://pro.europeana.eu/page/get-api
SMITHSONIAN_API_KEY=       # https://api.data.gov/signup/ (Smithsonian Open Access)
OPENVERSE_CLIENT_ID=       # optional, raises Openverse rate limits
OPENVERSE_CLIENT_SECRET=

# --- Search engines (images) ------------------------------------------
# Yandex Cloud Search API v2 (image search): https://yandex.cloud/en/docs/search-api/
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
# Google Programmable Search JSON API: https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Video platforms --------------------------------------------------
YOUTUBE_API_KEY=           # YouTube Data API v3 (search with videoLicense=creativeCommon)
VK_ACCESS_TOKEN=           # VK API user token with "video" scope (video.search)
REDDIT_CLIENT_ID=          # https://www.reddit.com/prefs/apps (script app)
REDDIT_CLIENT_SECRET=
X_BEARER_TOKEN=            # X API v2 (paid tiers only include search) — used for metadata of manual URLs

# --- Optional AI helpers ----------------------------------------------
# Text-to-speech fallback when no narration audio is provided (edge-tts needs no key).
TTS_ENGINE=edge            # edge | none
TTS_VOICE_UZ=uz-UZ-SardorNeural
TTS_VOICE_RU=ru-RU-DmitryNeural
TTS_VOICE_EN=en-GB-RyanNeural
# Transcription for narration alignment (faster-whisper, local, no key)
WHISPER_MODEL=small
