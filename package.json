{
  "name": "palov-motion-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion motion-design video: \"Ovqat sovidi, surat hali tayyor emas!\" (1080p, 60fps)",
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts PalovVideo out/palov-video.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=192k --x264-preset=slow",
    "render:fast": "remotion render src/index.ts PalovVideo out/palov-video-preview.mp4 --codec=h264 --crf=26 --scale=0.5",
    "still": "remotion still src/index.ts PalovVideo out/still.png --frame=120",
    "voiceover": "tsx scripts/generate-voiceover.ts",
    "voiceover:eleven": "tsx scripts/generate-voiceover-elevenlabs.ts",
    "assets": "tsx scripts/assets-status.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "@remotion/media-utils": "4.0.535",
    "@remotion/transitions": "4.0.535",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
