{
 "duration": 48.11,
 "sentences": [
  {
   "i": 0,
   "text": "Gaz yo'q uylar uchun yangi imtiyoz!",
   "say": "Gaz yo'q uylar uchun yangi imtiyoz!",
   "start": 0.35,
   "end": 2.03
  },
  {
   "i": 1,
   "text": "Vazirlar Mahkamasi qaroriga ko'ra, elektr energiyasining oylik bazaviy me'yori 200 kilovatt-soatdan 350 kilovatt-soatga oshirildi.",
   "say": "Vazirlar Mahkamasi qaroriga ko'ra, elektr energiyasining oylik bazaviy me'yori ikki yuz kilovatt-soatdan uch yuz ellik kilovatt-soatga oshirildi.",
   "start": 2.25,
   "end": 10.41
  },
  {
   "i": 2,
   "text": "Shu me'yor doirasida har bir kilovatt-soat uchun 650 so'm to'lanadi.",
   "say": "Shu me'yor doirasida har bir kilovatt-soat uchun olti yuz ellik so'm to'lanadi.",
   "start": 10.63,
   "end": 14.95
  },
  {
   "i": 3,
   "text": "Imtiyoz tabiiy gaz bilan ta'minlanmagan yoki gaz yetkazib berish cheklangan hududlardagi xonadonlarga tegishli.",
   "say": "Imtiyoz tabiiy gaz bilan ta'minlanmagan yoki gaz yetkazib berish cheklangan hududlardagi xonadonlarga tegishli.",
   "start": 15.17,
   "end": 21.31
  },
  {
   "i": 4,
   "text": "Yangi tartib 1-noyabrdan amal qiladi, shuning uchun noyabr oyi to'lovlari ham qayta hisoblanadi.",
   "say": "Yangi tartib birinchi noyabrdan amal qiladi, shuning uchun noyabr oyi to'lovlari ham qayta hisoblanadi.",
   "start": 21.53,
   "end": 27.43
  },
  {
   "i": 5,
   "text": "Masalan, oyiga 300 kilovatt-soat ishlatgan xonadon eski me'yorda 220 ming so'm to'lar edi.",
   "say": "Masalan, oyiga uch yuz kilovatt-soat ishlatgan xonadon eski me'yorda ikki yuz yigirma ming so'm to'lar edi.",
   "start": 27.65,
   "end": 33.37
  },
  {
   "i": 6,
   "text": "Yangi me'yorda esa hisob-kitobga ko'ra, bu summa 195 ming so'mni tashkil qiladi.",
   "say": "Yangi me'yorda esa hisob-kitobga ko'ra, bu summa bir yuz to'qson besh ming so'mni tashkil qiladi.",
   "start": 33.59,
   "end": 38.83
  },
  {
   "i": 7,
   "text": "Eng muhimi, ariza yozish yoki idoralarga borish shart emas, imtiyoz avtomatik qo'llaniladi.",
   "say": "Eng muhimi, ariza yozish yoki idoralarga borish shart emas, imtiyoz avtomatik qo'llaniladi.",
   "start": 39.05,
   "end": 44.25
  },
  {
   "i": 8,
   "text": "Sizning hududingizda gaz bormi? Fikringizni izohda yozing.",
   "say": "Sizning hududingizda gaz bormi? Fikringizni izohda yozing.",
   "start": 44.47,
   "end": 47.89
  }
 ],
