{
 "duration": 44.31,
 "sentences": [
  {
   "i": 0,
   "text": "Qarshida tunda ko'p qavatli uyda gaz portladi.",
   "say": "Qarshida tunda ko'p qavatli uyda gaz portladi.",
   "start": 0.35,
   "end": 2.81
  },
  {
   "i": 1,
   "text": "Favqulodda vaziyatlar vazirligi xabariga ko'ra, hodisa 22-noyabr kuni tungi soat 00:28 da Batosh mahallasida sodir bo'lgan.",
   "say": "Favqulodda vaziyatlar vazirligi xabariga ko'ra, hodisa yigirma ikkinchi noyabr kuni tungi soat o'n ikkidan yigirma sakkiz daqiqa o'tganda, Batosh mahallasida sodir bo'lgan.",
   "start": 3.03,
   "end": 12.89
  },
  {
   "i": 2,
   "text": "Ko'p qavatli binoning ikkinchi qavatidagi xonadonda gaz-havo aralashmasi chaqnagan.",
   "say": "Ko'p qavatli binoning ikkinchi qavatidagi xonadonda gaz-havo aralashmasi chaqnagan.",
   "start": 13.11,
   "end": 17.65
  },
  {
   "i": 3,
   "text": "Chaqnash natijasida yong'in chiqqan, qutqaruvchilar uni qisqa vaqtda o'chirgan.",
   "say": "Chaqnash natijasida yong'in chiqqan, qutqaruvchilar uni qisqa vaqtda o'chirgan.",
   "start": 17.87,
   "end": 22.27
  },
  {
   "i": 4,
   "text": "Ikki kishi kuyish jarohati olib, shifoxonaga murojaat qilgan.",
   "say": "Ikki kishi kuyish jarohati olib, shifoxonaga murojaat qilgan.",
   "start": 22.49,
   "end": 26.05
  },
  {
   "i": 5,
   "text": "Xayriyatki, halok bo'lganlar yo'q.",
   "say": "Xayriyatki, halok bo'lganlar yo'q.",
   "start": 26.27,
   "end": 28.09
  },
  {
   "i": 6,
   "text": "Mas'ul idoralar hodisa sabablarini aniqlash uchun surishtiruv olib bormoqda.",
   "say": "Mas'ul idoralar hodisa sabablarini aniqlash uchun surishtiruv olib bormoqda.",
   "start": 28.31,
   "end": 32.89
  },
  {
   "i": 7,
   "text": "Eslatib o'tamiz, 5-noyabr kuni Toshkentdagi ko'p qavatli uyda ham gaz portlab, bir kishi jarohatlangan edi.",
   "say": "Eslatib o'tamiz, beshinchi noyabr kuni Toshkentdagi ko'p qavatli uyda ham gaz portlab, bir kishi jarohatlangan edi.",
   "start": 33.11,
   "end": 39.49
  },
  {
   "i": 8,
   "text": "Qishda gaz jihozlaridan foydalanishda ehtiyot bo'ling. Fikringizni izohda yozing.",
   "say": "Qishda gaz jihozlaridan foydalanishda ehtiyot bo'ling. Fikringizni izohda yozing.",
   "start": 39.71,
   "end": 44.09
  }
 ],
